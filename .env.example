# Copy to .env and uncomment what you need. Every line is optional.

# Pick your GPU once, so a plain `docker compose up -d --build` uses it.
#   AMD or Intel:  compose.yaml:compose.amd.yaml
#   NVIDIA:        compose.yaml:compose.nvidia.yaml
#   No GPU:        leave it commented out
# COMPOSE_FILE=compose.yaml:compose.amd.yaml

# Port on the host.
# PORT=3300

# Where things live on the host.
# FILES_DIR=./files
# CACHE_DIR=./cache
# DATA_DIR=./data

# User and group the app runs as. Match the owner of FILES_DIR (`id -u`, `id -g`).
# PUID=1000
# PGID=1000

# AMD / Intel only: the groups that own /dev/dri. Check with `getent group render video`.
# RENDER_GID=993
# VIDEO_GID=44
